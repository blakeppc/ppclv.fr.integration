# FieldRoutes API Credentials
# Copy this file to .env and fill in your values
# NEVER share your .env file or commit it to GitHub

# --- Office 1: Preventive Las Vegas (ppclv1.fieldroutes.com) ---
FR_OFFICE1_SUBDOMAIN=ppclv1
FR_OFFICE1_KEY=your_office1_api_key_here
FR_OFFICE1_TOKEN=your_office1_api_token_here

# --- Office 2: Preventive Pest Control Commercial (ppclv2.fieldroutes.com) ---
FR_OFFICE2_SUBDOMAIN=ppclv2
FR_OFFICE2_KEY=your_office2_api_key_here
FR_OFFICE2_TOKEN=your_office2_api_token_here

